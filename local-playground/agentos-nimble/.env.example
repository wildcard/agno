# Copy to .env and fill in. .env is gitignored and must never be committed.
# Values are read from the environment; nothing here is written to the browser.

# --- mode -------------------------------------------------------------------
# test = deterministic + non-billable (default).  live = real Nimble + real LLM.
NIMBLE_PLAYGROUND_MODE=test

# --- the protected edge -----------------------------------------------------
# The origin refuses every request without this. run.sh generates one per run
# if unset, which is the safer default for local work.
# NIMBLE_EDGE_SECRET=
NIMBLE_EDGE_AUDIENCE=agentos-nimble-playground

# --- Nimble (live mode) -----------------------------------------------------
# Shared server-side fallback. A per-session override set in the console wins.
# NIMBLE_API_KEY=
# Optional default agent to run against.
# NIMBLE_AGENT_ID=

# --- driving model (live mode) ----------------------------------------------
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- status-poll pacing -----------------------------------------------------
# Workspace convention: one Nimble run-status poll every 10 seconds.
# Applies to run-status polling only, never to SSE/WebSocket or UI timers.
# Set to 0 ONLY as an explicit test-only override.
NIMBLE_POLL_INTERVAL_SECONDS=10
NIMBLE_POLL_DEADLINE_SECONDS=300
